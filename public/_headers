# ============================================================
#  Headers de seguridad — DocTravel / TradingDocs
#  Netlify sirve este archivo junto a _redirects.
#
#  CSP en modo enforced (Content-Security-Policy). Arrancó en
#  Report-Only hasta validar en staging que no había violations
#  reales. Si una feature nueva carga un recurso externo y se
#  rompe, temporalmente volvé a "Content-Security-Policy-Report-Only"
#  para ver el recurso bloqueado en consola y agregarlo acá.
# ============================================================

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Dominios de Google Ads (googleadservices, doubleclick, googlesyndication, google.com)
  # agregados para medición de conversiones de campañas. Sin impacto hasta activarlas.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://browser.sentry-cdn.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.ingest.us.sentry.io https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.emailjs.com https://cdn.jsdelivr.net https://unpkg.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://www.googleadservices.com https://ad.doubleclick.net https://www.google.com https://google.com https://www.google.com.ar; frame-src 'self' https://*.firebaseapp.com https://apis.google.com https://www.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# URLs anteriores: stub de reexport. max-age corto para que dejen el modulo completo cacheado.
/js/*
  Cache-Control: public, max-age=60, must-revalidate

# Cada carpeta contiene una version completa del grafo de imports.
/js/v-*/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
